load("@crates//:defs.bzl", "all_crate_deps")
load("@tar.bzl//tar:tar.bzl", "tar")
load("//bazel:rust.bzl", "rust_library", "rust_test")

CORPUS = glob([
    "corpus/docs/**",
    "corpus/skills/**",
])

# The vendored docs and skills that `src/lib.rs` embeds, packed into a gzipped tar so that they
# take less space in the binary. The entries are relative to `corpus/`, which is how the crate
# names them.
#
# The mtree lists each file with fixed metadata, so the same corpus always packs to the same bytes.
# `glob` returns the files sorted, so the entries are sorted too. The lines are written out here
# rather than generated by tar.bzl's default mtree, because that mtree would also add an entry for
# each directory, and the crate expects an entry for each file only.
tar(
    name = "corpus",
    srcs = CORPUS,
    compress = "gzip",
    mtree = [
        "{} uid=0 gid=0 time=0 mode=0644 type=file content=$(execpath {})".format(
            path.removeprefix("corpus/"),
            path,
        )
        for path in CORPUS
    ],
)

rust_library(
    name = "mcp",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":corpus"],
    rustc_env = {"MIRRORD_MCP_CORPUS": "$(execpath :corpus)"},
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    crate = ":mcp",
    deps = all_crate_deps(normal_dev = True),
)
