load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:rust.bzl", "rust_binary", "rust_library")

rust_library(
    name = "config",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "schema",
    srcs = ["src/bin/schema.rs"],
    # A binary of the package is named after its file, as Cargo names it.
    crate_name = "schema",
    deps = all_crate_deps(normal = True) + [":config"],
)

# The schema that `//:mirrord_schema` compares with `mirrord-schema.json`.
run_binary(
    name = "schema_json",
    outs = ["mirrord-schema.json"],
    args = ["$(execpath mirrord-schema.json)"],
    tool = ":schema",
    visibility = ["//:__pkg__"],
)
