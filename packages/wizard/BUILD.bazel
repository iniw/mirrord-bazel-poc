load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

# `packages/ui` compiles the wizard straight from its sources, together with its dependencies.
js_library(
    name = "wizard",
    srcs = glob(["src/**"]) + ["package.json"],
    visibility = ["//packages/ui:__pkg__"],
    deps = [":node_modules"],
)
